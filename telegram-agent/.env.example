# Configure these only in the separate Vercel agent project's Environment Variables.
# Never commit real values or send them in Telegram/chat.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPENAI_API_KEY=
GITHUB_TOKEN=

# Repository to modify through Draft PRs only.
GITHUB_REPOSITORY=michaelchiin12-cpu/aura-sports-official

# Comma-separated numeric Telegram user IDs; start with owner only.
OWNER_TELEGRAM_IDS=
# Comma-separated numeric Telegram chat IDs for the approved chat(s).
ALLOWED_TELEGRAM_CHAT_IDS=

# Optional model override; choose an available model in your OpenAI account.
OPENAI_MODEL=
